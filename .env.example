# Backend
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=kage
DB_PASSWORD=kage
DB_NAME=kage_legacy

# Frontend (Vite)
VITE_API_URL=http://localhost:3000

# Scheduler intégré dans le process API (désactiver si cron externe npm run cycle:tick)
# ENABLE_SCHEDULER=false
# SCHEDULER_TICK_MS=60000

# Auth : repli automatique sur le compte démo si pas de session (défaut activé)
# AUTH_DEMO_FALLBACK=false

# Dev : autorise POST /api/dev/* en production
# ENABLE_DEV_TOOLS=true

# CORS (frontend en prod, ex. https://kage.example.com)
# CORS_ORIGIN=https://kage.example.com
