# Backend
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=kage
DB_PASSWORD=kage
DB_NAME=kage_legacy

# Frontend (Vite)
VITE_API_URL=http://localhost:3000
# Optionnel en local — injecté automatiquement au publish Docker (tag vX.Y.Z)
# VITE_APP_VERSION=dev

# Scheduler intégré dans le process API (désactiver si cron externe npm run cycle:tick)
# ENABLE_SCHEDULER=false
# SCHEDULER_TICK_MS=60000

# Auth : repli automatique sur le compte démo si pas de session (défaut activé)
# AUTH_DEMO_FALLBACK=false

# Google Sign-In (OAuth Client ID type « Web application » — Google Cloud Console)
# Sans cette variable, le bouton Google est masqué.
# GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com

# Dev : autorise POST /api/dev/* en production
# ENABLE_DEV_TOOLS=true

# CORS (frontend en prod, ex. https://kage.example.com)
# CORS_ORIGIN=https://kage.example.com

# Stripe — shop Kage Coins + Battle Pass Premium + pack bienvenue (voir docs/OPERATIONS.md)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID_BATTLE_PASS=price_...   # optionnel (sinon 5,00 € via price_data)
# STRIPE_PRICE_ID_WELCOME=price_...      # optionnel pack bienvenue (sinon 5,00 €)
# STRIPE_PRICE_ID_COIN_EMBER=price_...    # optionnel par pack (spark|ember|forge|vault)
# APP_PUBLIC_URL=https://kage.example.com
# SHOP_COIN_STUB=true
# BATTLE_PASS_STUB_UNLOCK=true
# Webhook : checkout.session.completed
