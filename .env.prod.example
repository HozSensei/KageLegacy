# Copier en .env.prod sur le NAS (ne pas committer).

KAGE_HOST_PORT=3002

DB_HOST=192.168.4.39
DB_PORT=3306
DB_USER=kage
DB_PASSWORD=change_me
DB_NAME=kage_legacy

CORS_ORIGIN=https://kage.jeromedessy.be
APP_PUBLIC_URL=https://kagelegacy.jeromedessy.be
ENABLE_SCHEDULER=true
AUTH_DEMO_FALLBACK=false

# Stripe live — KC packs + BP premium + pack bienvenue (docs/OPERATIONS.md)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID_BATTLE_PASS=price_...
# STRIPE_PRICE_ID_WELCOME=price_...

# Optionnel — réancrer le cycle (une fois, puis retirer CYCLE_START_AT_APPLY)
# Ex. hier midi (heure de Bruxelles, été UTC+2) :
# CYCLE_START_AT=2026-07-06T12:00:00+02:00
# CYCLE_START_AT_APPLY=true

# Seeds catalogues V2 (cartes / talents / battle pass) : lancés auto après migrations.
# Idempotents, sans compte démo. Mettre à 1 uniquement pour sauter (debug / maintenance).
# SKIP_V2_SEEDS=1
