{
  "name": "kage-legacy-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write \"src/**/*.{js,json}\"",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "npm run db:seed-v2",
    "db:seed-cards": "node scripts/seedCards.js",
    "db:seed-talents": "node scripts/seedTalentTree.js",
    "db:seed-battle-pass": "node scripts/seedBattlePass.js",
    "db:seed-v2": "npm run db:seed-cards && npm run db:seed-talents && npm run db:seed-battle-pass",
    "test:scheduler": "node scripts/testScheduler.js",
    "test:e2e-guard": "node scripts/testE2eGuard.js",
    "test:guest-cleanup": "node scripts/testGuestCleanup.js",
    "test:card-system": "node scripts/testCardSystem.js",
    "test:starter-loadout": "node scripts/testStarterLoadout.js",
    "test:boosters": "node scripts/testBoosters.js",
    "test:shop": "node scripts/testShopCatalog.js",
    "test:shop-stripe": "node scripts/testShopStripe.js",
    "test:economy": "node scripts/testEconomy.js",
    "test:talent-tree": "node scripts/testTalentTree.js",
    "test:combat-engine": "node scripts/testCombatEngine.js",
    "test:boss-phases": "node scripts/testBossPhases.js",
    "test:combat-balance": "node scripts/testCombatBalance.js",
    "test:combat-balance:report": "node scripts/testCombatBalance.js --report",
    "test:tcg-balance": "node scripts/testCombatBalance.js",
    "test:tcg-balance:report": "node scripts/testCombatBalance.js --report",
    "test:type-advantage": "node scripts/testTypeAdvantage.js",
    "test:mission-run": "node scripts/testMissionRun.js",
    "test:battle-pass": "node scripts/testBattlePass.js",
    "test:achievements": "node scripts/testAchievements.js",
    "test:player-character": "node scripts/testPlayerCharacter.js",
    "test:pvp-matchmaking": "node scripts/testPvpMatchmaking.js",
    "test:factions-leaderboard": "node scripts/testFactionsLeaderboard.js",
    "test:public-app-url": "node scripts/testPublicAppUrl.js",
    "e2e:preflight": "node scripts/e2ePreflight.js",
    "e2e:seed-battle-pass": "node scripts/seedBattlePass.js --if-empty",
    "e2e:prepare-tcg": "node scripts/e2ePrepareTcg.js",
    "e2e:ensure-player": "node scripts/e2eEnsurePlayerCharacter.js",
    "guest:purge": "node scripts/purgeExpiredGuests.js",
    "audit:imports": "node scripts/auditCrossImports.js",
    "audit:i18n": "node scripts/auditCatalogI18n.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mysql2": "^3.12.0",
    "stripe": "^17.7.0",
    "ws": "^8.23.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.2.5"
  }
}
